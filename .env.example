SECRET_KEY=change-me-generate-a-long-random-string

# Free local development: no PostgreSQL install required.
DATABASE_URL=sqlite+aiosqlite:///./codejam.db
AUTO_CREATE_SQLITE_TABLES=true

# Deployment PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://codejam:codejam123@localhost:5432/codejam

# Local Redis:
REDIS_URL=redis://localhost:6379/0

# For providers such as Upstash, use their TLS Redis URL:
# REDIS_URL=rediss://default:password@example.upstash.io:6379/0

EXECUTION_TIMEOUT=10
WORKSPACE_RUNTIME_IMAGE=codejam-workspace-runner:latest
WORKSPACE_RUNTIME_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://codejam-collab.vercel.app
FRONTEND_URL=https://codejam-collab.vercel.app

# Local-only frontend URL:
# FRONTEND_URL=http://localhost:5173

# Recommended for Render/deployed apps: Resend sends emails over HTTPS.
# Keep the real API key only in Render environment variables, never in Git.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_FROM_NAME=CodeJam

# Optional SMTP fallback. If neither Resend nor SMTP is configured, the app
# still creates invite links, but it will not send email automatically.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_FROM_NAME=CodeJam
# SMTP_STARTTLS=true
